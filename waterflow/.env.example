# ══════════════════════════════════════════════════════════════════
# Waterflow 2 — Configuration
# Copiez ce fichier en .env et renseignez les valeurs
# ══════════════════════════════════════════════════════════════════

# ── Base de données ────────────────────────────────────────────────
DATABASE_URL=sqlite:///waterflow2.db
# PostgreSQL : DATABASE_URL=postgresql://user:pass@localhost:5432/waterflow2

# ── Modèle ML (MLflow) ────────────────────────────────────────────
MLFLOW_TRACKING_URI=sqlite:///mlflow_water.db
MLFLOW_URI=models:/WaterQualityXGBoost/1
SCALER_PATH=model_artifacts/robust_scaler.pkl

# ── OCR ───────────────────────────────────────────────────────────
# Au moins l'une des deux clés est requise pour /ingest/ocr
OCR_SPACE_API_KEY=
ANTHROPIC_API_KEY=

# ── Experts (analyste qualité / responsable exploitation) ─────────
#
# Modèle simple : tokens statiques côté serveur.
# Format : "login:token:role,login2:token2:role2"
# Rôles  : analyste | exploit
#
# Bonnes pratiques :
#   - Utilisez secrets.token_urlsafe(32) pour générer chaque token
#   - Minimum 20 caractères par token
#   - Un token par personne pour traçabilité dans les audit_logs
#   - Changez les tokens en cas de départ d'un expert
#
# Générer des tokens depuis Python :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
EXPERT_TOKENS="alice:REMPLACER_TOKEN_ALICE_ICI:analyste,bob:REMPLACER_TOKEN_BOB_ICI:exploit"

# ── Serveur ───────────────────────────────────────────────────────
PORT=8080
FLASK_ENV=production
MAX_UPLOAD_MB=20
